                        "type": "integer",
                        "example": 45
                    },
                    "package_id": {
                        "type": "integer",
                        "example": 30
                    },
                    "booking_date": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-12-01 10:00:00"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-11-16 23:24:23"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-11-16 23:24:23"
